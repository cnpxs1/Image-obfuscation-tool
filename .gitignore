# 依赖文件夹
node_modules/
package-lock.json
yarn.lock

# 由 pnpm 依赖生成的第三方库本地降级副本
assets/

# 项目构建打包产物（dist 由 CI 自动更新到仓库，本地默认忽略）
dist/
build/

# IDE编辑器配置文件
.idea/
.vscode/
.vs/
*.sublime-project
*.sublime-workspace

# Claude Code配置文件
.claude/

# Codex 本地说明（暂不入库，内容与 CLAUDE.md 重复）
AGENTS.md

# 本地临时需求文档（隐藏的开发文档）
.Exacta*.md

# 环境变量隐私文件（本地配置，禁止提交）
.env
.env.local
.env.development
.env.production

# 系统垃圾文件
.DS_Store       # Mac系统文件
Thumbs.db       # Windows缩略图缓存

# 日志 & 缓存文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
__pycache__/

# 项目文档（开发文档）
dev-docs/

# 本地视觉调试工具产物（截图等）
.dsh-vision-toolkit/